# Optional. Without these variables Saans uses clearly labeled demo air data
# when the air service is unavailable and deterministic fallback wording.
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-20b
# Groq uses the OpenAI-compatible API. Replace the key with your own server-side key.
LLM_BASE_URL=https://api.groq.com/openai
